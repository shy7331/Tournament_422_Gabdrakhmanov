<Page x:Class="Tournament_422_Gabdrakhmanov.Pages.ParticipantPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tournament_422_Gabdrakhmanov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ParticipantPage">

    <Grid Margin="10" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Добро пожаловать, участник"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

    
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Width="400">
          
            <GroupBox Header="Информация об участнике">
                <StackPanel>
                    <TextBlock Text="Имя: " FontWeight="Bold"/>
                    <TextBlock x:Name="NameTextBlock" Margin="0,0,0,10"/>

                    <TextBlock Text="Никнейм: " FontWeight="Bold"/>
                    <TextBlock x:Name="NicknameTextBlock" Margin="0,0,0,10"/>

                    <TextBlock Text="Email: " FontWeight="Bold"/>
                    <TextBlock x:Name="EmailTextBlock" Margin="0,0,0,10"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Регистрация команды на турнир" Margin="0,-5,0,0">
                <StackPanel>
                    <TextBlock Text="Выберите команду:" FontWeight="Bold"/>
                    <ComboBox x:Name="TeamComboBox" Height="30" Margin="0,5,0,15"/>

                    <TextBlock Text="Выберите турнир:" FontWeight="Bold"/>
                    <ComboBox x:Name="TournamentForTeamComboBox" Height="30" Margin="0,5,0,15"/>

                    <Button Content="Зарегистрировать команду"
                Height="40" Width="200"
                HorizontalAlignment="Center"
                Click="RegisterTeamForTournamentButton_Click"/>

                   
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </Grid>
</Page>
