<Page x:Class="Tournament_422_Gabdrakhmanov.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tournament_422_Gabdrakhmanov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid Background="White">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock Text="Логин" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" Height="20" Margin="0,0,0,15" />

            <TextBlock Text="Пароль" FontSize="16" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="20" Margin="0,0,0,15"/>

            <Button Content="Войти" Height="40"  Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
